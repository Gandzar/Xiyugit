# Buat GitHub OAuth App: Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=isi_client_id
GITHUB_CLIENT_SECRET=isi_client_secret

# Minimal 32 karakter acak. Jangan pernah commit nilai aslinya.
SESSION_SECRET=ganti_dengan_random_secret_minimal_32_karakter

# URL deployment, tanpa slash di akhir.
APP_URL=http://localhost:3000
